PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/work_order?schema=public"

# RS256 staff token keys: generate yours with the commands in docs/local-setup.md,
# which append the three lines below to .env; none of them is versioned
# STAFF_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# STAFF_JWT_REFRESH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# STAFF_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
STAFF_JWT_KEY_ID=staff-local
STAFF_JWT_ISSUER=oficina-identity
STAFF_JWT_AUDIENCE=oficina-services
STAFF_JWT_EXPIRATION=10m
STAFF_JWT_REFRESH_EXPIRATION=7d
CUSTOMER_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
CUSTOMER_JWT_ISSUER=oficina-customer-auth
CUSTOMER_JWT_AUDIENCE=oficina-api

BCRYPT_SALT_ROUNDS=12

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Oficina Mecânica <noreply@oficina.local>"

# Messaging (SNS/SQS FIFO). Locally, the compose LocalStack creates the topic and
# the queues; AWS_ENDPOINT_URL is read by the SDK itself and does not exist in the cluster.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WORK_ORDER_QUEUE_NAME=work-order.fifo
MESSAGING_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-events.fifo

# Cache (Valkey). redis:// locally; rediss:// with a password in the cluster.
CACHE_URL=redis://:valkey@localhost:6379
# Lifetime of each entry in seconds: an integer greater than zero (blank = 43200, 12 h).
# Any other value stops the API from starting.
CACHE_TTL_SECONDS=43200

ALLOWED_ORIGINS=http://localhost:3000

# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
OTEL_SERVICE_NAME=oficina-mecanica-work-order-service
OTEL_SERVICE_NAMESPACE=oficina-mecanica
# TRUSTED_PROXY_CIDRS: comma-separated list (e.g. 10.0.0.0/8,loopback).
# Missing or invalid = no trusted proxy, and forwarded headers are ignored.
# TRUSTED_PROXY_CIDRS=

# Telemetry (OpenTelemetry). Blank = telemetry fully off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Without this key the SDK builds a LoggerProvider with a network OTLP exporter;
# with it, logs have a single path (stdout).
OTEL_LOGS_EXPORTER=none
# OTLP intakes of compatible destinations expect delta; cumulative drops points
# at process start. Standard variable of the open protocol.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
# Export deadlines. The SDK defaults (10 s for OTLP, 30 s for the metric reader)
# do not fit what is left of terminationGracePeriodSeconds after the drain
# window; the code already applies 5 s, and these variables are the operator
# override.
# OTEL_EXPORTER_OTLP_TIMEOUT=5000
# OTEL_METRIC_EXPORT_TIMEOUT=5000
