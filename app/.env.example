PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techchallenge?schema=public"

JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRATION=7d
CUSTOMER_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
CUSTOMER_JWT_ISSUER=oficina-customer-auth
CUSTOMER_JWT_AUDIENCE=oficina-api

BCRYPT_SALT_ROUNDS=12

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Oficina Mecânica <noreply@oficina.local>"

# Mensageria (SNS/SQS FIFO). Localmente, o LocalStack do compose cria o tópico e
# as filas; AWS_ENDPOINT_URL é lido pelo próprio SDK e não existe no cluster.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WORK_ORDER_QUEUE_NAME=work-order.fifo
MESSAGING_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-events.fifo

# Cache (Valkey). redis:// local; rediss:// com senha no cluster.
CACHE_URL=redis://:valkey@localhost:6379
# Validade de cada entrada em segundos: inteiro maior que zero (vazio = 43200, 12 h).
# Outro valor impede a API de subir.
CACHE_TTL_SECONDS=43200

ALLOWED_ORIGINS=http://localhost:3000

# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent (padrão: info)
LOG_LEVEL=info
OTEL_SERVICE_NAME=oficina-mecanica-work-order-service
OTEL_SERVICE_NAMESPACE=oficina-mecanica
# TRUSTED_PROXY_CIDRS: lista separada por vírgula (ex.: 10.0.0.0/8,loopback).
# Ausente ou inválida = nenhum proxy confiável e cabeçalhos encaminhados são ignorados.
# TRUSTED_PROXY_CIDRS=

# Telemetria (OpenTelemetry). VAZIO = telemetria completamente desligada
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sem esta chave o SDK instancia um LoggerProvider com exportador OTLP de rede, # e os logs tem um caminho unico (stdout).
OTEL_LOGS_EXPORTER=none
# A intake OTLP dos destinos compativeis espera delta; cumulative descarta
# pontos na inicializacao do processo. Variavel padronizada do protocolo aberto.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
# Prazos de exportacao. Os padroes do SDK (10 s no OTLP, 30 s no leitor de
# metricas) nao cabem no que sobra de terminationGracePeriodSeconds depois da
# janela de drenagem; o codigo ja aplica 5 s, e estas variaveis sao a
# sobreposicao do operador.
# OTEL_EXPORTER_OTLP_TIMEOUT=5000
# OTEL_METRIC_EXPORT_TIMEOUT=5000
