generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MECHANIC
  ATTENDANT
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum WorkOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  AWAITING_APPROVAL
  APPROVED
  AWAITING_PAYMENT
  REJECTED
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum WorkOrderServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SagaType {
  QUOTE_APPROVAL
  PAYMENT
}

enum SagaStatus {
  RESERVING_STOCK
  AWAITING_PAYMENT
  COMPENSATING
  COMPLETED
  COMPENSATED
}

enum SagaFailureReason {
  INSUFFICIENT_STOCK
  WORK_ORDER_NOT_AWAITING
  WORK_ORDER_NOT_PAYABLE
  PAYMENT_EXPIRED
  PAYMENT_REJECTED
  PAYMENT_CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(150)
  email             String    @unique @db.VarChar(150)
  cpf               String?   @unique @db.VarChar(11)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              UserRole?
  isActive          Boolean   @default(true) @map("is_active")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  passwordResetCode PasswordResetCode?

  @@map("users")
}

model Customer {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(150)
  document  String       @unique @db.VarChar(18)
  type      CustomerType @default(INDIVIDUAL)
  email     String       @unique @db.VarChar(150)
  phone     String       @db.VarChar(20)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  address     Address?
  vehicles    Vehicle[]
  workOrders  WorkOrder[]
  accessUsers UserCustomer[]

  @@map("customers")
}

model Address {
  customerId String @id @map("customer_id") @db.Uuid
  street     String @db.VarChar(255)
  city       String @db.VarChar(100)
  state      String @db.VarChar(2)
  zipCode    String @map("zip_code") @db.VarChar(9)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Vehicle {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  plate      String   @unique @db.VarChar(10)
  brand      String   @db.VarChar(60)
  model      String   @db.VarChar(60)
  year       Int      @db.SmallInt
  color      String?  @db.VarChar(40)
  mileage    Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  customer   Customer    @relation(fields: [customerId], references: [id])
  workOrders WorkOrder[]

  @@index([customerId])
  @@map("vehicles")
}

model WorkOrderStatusInfo {
  code       WorkOrderStatus @id
  priority   Int             @unique
  workOrders WorkOrder[]

  @@map("work_order_statuses")
}

model WorkOrder {
  id                 String          @id @default(uuid()) @db.Uuid
  number             String          @unique @db.VarChar(20)
  customerId         String          @map("customer_id") @db.Uuid
  vehicleId          String          @map("vehicle_id") @db.Uuid
  assignedUserId     String?         @map("assigned_user_id") @db.Uuid
  status             WorkOrderStatus @default(RECEIVED)
  problemDescription String?         @map("problem_description") @db.Text
  internalNotes      String?         @map("internal_notes") @db.Text
  mileageAtService   Int?            @map("mileage_at_service")
  totalAmount        Decimal         @default(0) @map("total_amount") @db.Decimal(10, 2)
  version            Int             @default(1)
  approvedAt         DateTime?       @map("approved_at")
  rejectedAt         DateTime?       @map("rejected_at")
  startedAt          DateTime?       @map("started_at")
  finishedAt         DateTime?       @map("finished_at")
  deliveredAt        DateTime?       @map("delivered_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")

  customer       Customer              @relation(fields: [customerId], references: [id])
  vehicle        Vehicle               @relation(fields: [vehicleId], references: [id])
  statusInfo     WorkOrderStatusInfo   @relation(fields: [status], references: [code])
  services       WorkOrderService[]
  partSupplies   WorkOrderPartSupply[]
  statusHistory  StatusHistory[]
  outboxMessages OutboxMessage[]
  sagaInstances  SagaInstance[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedUserId])
  @@index([status])
  @@index([status, createdAt])
  @@map("work_orders")
}

model WorkOrderService {
  workOrderId String                 @map("work_order_id") @db.Uuid
  serviceId   String                 @map("service_id") @db.Uuid
  quantity    Int                    @default(1)
  unitPrice   Decimal                @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal                @map("total_price") @db.Decimal(10, 2)
  status      WorkOrderServiceStatus @default(PENDING)
  startedAt   DateTime?              @map("started_at")
  finishedAt  DateTime?              @map("finished_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([workOrderId, serviceId])
  @@index([serviceId])
  @@map("work_order_services")
}

model WorkOrderPartSupply {
  workOrderId  String   @map("work_order_id") @db.Uuid
  partSupplyId String   @map("part_supply_id") @db.Uuid
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([workOrderId, partSupplyId])
  @@index([partSupplyId])
  @@map("work_order_part_supplies")
}

model StatusHistory {
  id             String           @id @default(uuid()) @db.Uuid
  workOrderId    String           @map("work_order_id") @db.Uuid
  changedById    String?          @map("changed_by_id") @db.Uuid
  previousStatus WorkOrderStatus? @map("previous_status")
  newStatus      WorkOrderStatus  @map("new_status")
  notes          String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([changedById])
  @@map("status_history")
}

model SagaInstance {
  id            String             @id @default(uuid()) @db.Uuid
  type          SagaType
  correlationId String             @map("correlation_id") @db.Uuid
  workOrderId   String             @map("work_order_id") @db.Uuid
  status        SagaStatus
  failureReason SagaFailureReason? @map("failure_reason")
  originStatus  WorkOrderStatus?   @map("origin_status")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([type, correlationId])
  @@index([workOrderId])
  @@map("saga_instances")
}

model UserCustomer {
  userId     String   @map("user_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([userId, customerId])
  @@index([customerId])
  @@map("user_customers")
}

model PasswordResetCode {
  userId    String   @id @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────

model OutboxMessage {
  id           BigInt   @id @default(autoincrement())
  messageId    String   @unique @default(uuid()) @map("message_id") @db.Uuid
  type         String   @db.VarChar(64)
  workOrderId  String?  @map("work_order_id") @db.Uuid
  payload      Json
  traceContext Json     @default("{}") @map("trace_context")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@map("outbox")
}
