generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MECHANIC
  ATTENDANT
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum WorkOrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum WorkOrderServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum QuoteStatus {
  PENDING
  SENT
  APPROVED
  REJECTED
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum Unit {
  UN
  KG
  L
  ML
  M
  CX
  PC
  JG
}

// Categoria distingue Peça de Insumo
enum PartSupplyCategory {
  PART
  SUPPLY
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(150)
  email             String    @unique @db.VarChar(150)
  cpf               String?   @unique @db.VarChar(11)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              UserRole?
  isActive          Boolean   @default(true) @map("is_active")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  assignedWorkOrders WorkOrder[]        @relation("AssignedUser")
  statusChanges      StatusHistory[]
  customerAccesses   UserCustomer[]
  passwordResetCode  PasswordResetCode?

  @@map("users")
}

model Customer {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(150)
  document  String       @unique @db.VarChar(18)
  type      CustomerType @default(INDIVIDUAL)
  email     String       @unique @db.VarChar(150)
  phone     String       @db.VarChar(20)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  address     Address?
  vehicles    Vehicle[]
  workOrders  WorkOrder[]
  accessUsers UserCustomer[]

  @@map("customers")
}

model Address {
  customerId String @id @map("customer_id") @db.Uuid
  street     String @db.VarChar(255)
  city       String @db.VarChar(100)
  state      String @db.VarChar(2)
  zipCode    String @map("zip_code") @db.VarChar(9)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Vehicle {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  plate      String   @unique @db.VarChar(10)
  brand      String   @db.VarChar(60)
  model      String   @db.VarChar(60)
  year       Int      @db.SmallInt
  color      String?  @db.VarChar(40)
  mileage    Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  customer   Customer    @relation(fields: [customerId], references: [id])
  workOrders WorkOrder[]

  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique @db.VarChar(150)
  description      String?  @db.Text
  basePrice        Decimal  @map("base_price") @db.Decimal(10, 2)
  estimatedTimeMin Int      @default(60) @map("estimated_time_min")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  workOrderServices WorkOrderService[]
  quoteServices     QuoteService[]

  @@map("services")
}

model PartSupply {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @db.VarChar(150)
  description   String?            @db.Text
  sku           String             @unique @db.VarChar(60)
  partNumber    String?            @map("part_number") @db.VarChar(60)
  category      PartSupplyCategory
  unit          Unit               @default(UN)
  costPrice     Decimal            @map("cost_price") @db.Decimal(10, 2)
  salePrice     Decimal            @map("sale_price") @db.Decimal(10, 2)
  stock         Int                @default(0)
  minStock      Int                @default(0) @map("min_stock")
  reservedStock Int                @default(0) @map("reserved_stock")
  version       Int                @default(1)
  expiresAt     DateTime?          @map("expires_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")

  stockMovements        StockMovement[]
  workOrderPartSupplies WorkOrderPartSupply[]
  quotePartSupplies     QuotePartSupply[]
  stockReservations     StockReservation[]

  @@map("parts_supplies")
}

model WorkOrderStatusInfo {
  code       WorkOrderStatus @id
  priority   Int             @unique
  workOrders WorkOrder[]

  @@map("work_order_statuses")
}

model WorkOrder {
  id                 String          @id @default(uuid()) @db.Uuid
  number             String          @unique @db.VarChar(20)
  customerId         String          @map("customer_id") @db.Uuid
  vehicleId          String          @map("vehicle_id") @db.Uuid
  assignedUserId     String?         @map("assigned_user_id") @db.Uuid
  status             WorkOrderStatus @default(RECEIVED)
  problemDescription String?         @map("problem_description") @db.Text
  internalNotes      String?         @map("internal_notes") @db.Text
  mileageAtService   Int?            @map("mileage_at_service")
  totalAmount        Decimal         @default(0) @map("total_amount") @db.Decimal(10, 2)
  version            Int             @default(1)
  approvedAt         DateTime?       @map("approved_at")
  rejectedAt         DateTime?       @map("rejected_at")
  startedAt          DateTime?       @map("started_at")
  finishedAt         DateTime?       @map("finished_at")
  deliveredAt        DateTime?       @map("delivered_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")

  customer          Customer              @relation(fields: [customerId], references: [id])
  vehicle           Vehicle               @relation(fields: [vehicleId], references: [id])
  assignedUser      User?                 @relation("AssignedUser", fields: [assignedUserId], references: [id])
  statusInfo        WorkOrderStatusInfo   @relation(fields: [status], references: [code])
  services          WorkOrderService[]
  partSupplies      WorkOrderPartSupply[]
  quotes            Quote[]
  statusHistory     StatusHistory[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  outboxMessages    OutboxMessage[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedUserId])
  @@index([status])
  @@index([status, createdAt])
  @@map("work_orders")
}

model WorkOrderService {
  workOrderId String                 @map("work_order_id") @db.Uuid
  serviceId   String                 @map("service_id") @db.Uuid
  quantity    Int                    @default(1)
  unitPrice   Decimal                @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal                @map("total_price") @db.Decimal(10, 2)
  status      WorkOrderServiceStatus @default(PENDING)
  startedAt   DateTime?              @map("started_at")
  finishedAt  DateTime?              @map("finished_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id])

  @@id([workOrderId, serviceId])
  @@index([serviceId])
  @@map("work_order_services")
}

model WorkOrderPartSupply {
  workOrderId  String   @map("work_order_id") @db.Uuid
  partSupplyId String   @map("part_supply_id") @db.Uuid
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  workOrder  WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partSupply PartSupply @relation(fields: [partSupplyId], references: [id])

  @@id([workOrderId, partSupplyId])
  @@index([partSupplyId])
  @@map("work_order_part_supplies")
}

model Quote {
  id             String      @id @default(uuid()) @db.Uuid
  workOrderId    String      @map("work_order_id") @db.Uuid
  servicesAmount Decimal     @default(0) @map("services_amount") @db.Decimal(10, 2)
  partsAmount    Decimal     @default(0) @map("parts_amount") @db.Decimal(10, 2)
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(10, 2)
  version        Int         @default(1)
  status         QuoteStatus @default(PENDING)
  notes          String?     @db.Text
  sentAt         DateTime?   @map("sent_at")
  approvedAt     DateTime?   @map("approved_at")
  rejectedAt     DateTime?   @map("rejected_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")

  workOrder     WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  services      QuoteService[]
  partsSupplies QuotePartSupply[]

  @@index([workOrderId])
  @@index([status])
  @@map("quotes")
}

model QuoteService {
  quoteId    String   @map("quote_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@id([quoteId, serviceId])
  @@index([serviceId])
  @@map("quote_services")
}

model QuotePartSupply {
  quoteId      String   @map("quote_id") @db.Uuid
  partSupplyId String   @map("part_supply_id") @db.Uuid
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  quote      Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  partSupply PartSupply @relation(fields: [partSupplyId], references: [id])

  @@id([quoteId, partSupplyId])
  @@index([partSupplyId])
  @@map("quote_part_supplies")
}

model StatusHistory {
  id             String           @id @default(uuid()) @db.Uuid
  workOrderId    String           @map("work_order_id") @db.Uuid
  changedById    String?          @map("changed_by_id") @db.Uuid
  previousStatus WorkOrderStatus? @map("previous_status")
  newStatus      WorkOrderStatus  @map("new_status")
  notes          String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  changedBy User?     @relation(fields: [changedById], references: [id])

  @@index([workOrderId])
  @@index([changedById])
  @@map("status_history")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  partSupplyId String            @map("part_supply_id") @db.Uuid
  workOrderId  String?           @map("work_order_id") @db.Uuid
  type         StockMovementType
  quantity     Int
  reason       String?           @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at")

  partSupply PartSupply @relation(fields: [partSupplyId], references: [id])
  workOrder  WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([partSupplyId])
  @@index([workOrderId])
  @@index([type])
  @@map("stock_movements")
}

model StockReservation {
  id           String   @id @default(uuid()) @db.Uuid
  partSupplyId String   @map("part_supply_id") @db.Uuid
  workOrderId  String   @map("work_order_id") @db.Uuid
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at")

  partSupply PartSupply @relation(fields: [partSupplyId], references: [id])
  workOrder  WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([partSupplyId])
  @@index([workOrderId])
  @@map("stock_reservations")
}

model UserCustomer {
  userId     String   @map("user_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([userId, customerId])
  @@index([customerId])
  @@map("user_customers")
}

model PasswordResetCode {
  userId    String   @id @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────

model OutboxMessage {
  id           BigInt   @id @default(autoincrement())
  messageId    String   @unique @default(uuid()) @map("message_id") @db.Uuid
  type         String   @db.VarChar(64)
  workOrderId  String?  @map("work_order_id") @db.Uuid
  payload      Json
  traceContext Json     @default("{}") @map("trace_context")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@map("outbox")
}
